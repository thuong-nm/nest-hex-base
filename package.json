{
  "name": "nest-hexa-base",
  "version": "0.0.1",
  "description": "Project-agnostic NestJS modular-monolith boilerplate (hexagonal bounded contexts).",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/*"
    },
    "#test/*": "./test/*"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:debug": "nest start --debug --watch",
    "typecheck": "pnpm i18n:types --check && tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --type-aware --deny-warnings src/ test/ scripts/",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs && tsx --conditions=development scripts/check-table-ownership.ts && tsx --conditions=development scripts/check-test-layout.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:admin": "nest start --entryFile seeds/seed-admin",
    "i18n:types": "tsx --conditions=development scripts/gen-i18n-types.ts",
    "gen:module": "plop module",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.0.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.2.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dependency-cruiser": "^18.4.0",
    "dotenv": "^18.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "^13.1.3",
    "plop": "^4.0.5",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.5.1"
}
