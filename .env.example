# --- App ---
NODE_ENV=development
PORT=8000
LOG_LEVEL=info
# Comma-separated list, or * to allow any origin.
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# --- Database ---
# Host port docker-compose publishes Postgres on; keep in sync with DATABASE_URL.
POSTGRES_PORT=55432
DATABASE_URL=postgresql://app:app@localhost:55432/app?schema=public

# --- i18n ---
# Fallback when the request names no supported language. Added to SUPPORTED_LANGS if missing.
DEFAULT_LANG=en
# Comma-separated. Each needs a src/i18n/<lang>/ folder, or startup fails.
SUPPORTED_LANGS=en,vi

# --- Auth ---
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Rate limit applied to /auth endpoints: LIMIT requests per TTL window.
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# --- Seed (pnpm seed:admin) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
