import { Get{{pascal entity}}UseCase } from '#src/modules/{{context}}/application/use-cases/get-{{entity}}.use-case.js';

describe('Get{{pascal entity}}UseCase', () => {
  it('returns the {{entity}}', async () => {
    const repository = new InMemory{{pascal entity}}Repository();
    const {{camel entity}} = {{pascal entity}}.create({ id: '00000000-0000-4000-8000-000000000001', name: 'Example', now: new Date() });
    await repository.create({{camel entity}});

    const result = await new Get{{pascal entity}}UseCase(repository).execute({{camel entity}}.id);

    expect(result).toMatchObject({ id: {{camel entity}}.id, name: 'Example' });
