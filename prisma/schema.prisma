// Table ownership is declared in prisma/ownership.json and enforced by `pnpm lint:arch`.
// Never add a Prisma relation between models owned by different modules: reference the
// other module's id as a plain column and go through its facade instead.

// Pinned rather than inferred from tsconfig: the Docker deps stage generates before tsconfig exists.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------- module: users ----------

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @db.Uuid
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @map("updated_at") @db.Timestamptz(3)

  @@index([role])
  @@index([status])
  @@map("users")
}

// ---------- module: auth ----------

model RefreshToken {
  id         String    @id @db.Uuid
  // Plain column on purpose: users belong to the users module (rule 7).
  userId     String    @map("user_id") @db.Uuid
  familyId   String    @map("family_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBy String?   @map("replaced_by") @db.Uuid
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
